# Copy this file to .env and populate strong unique secrets before running docker compose up.
# NEVER commit .env with real secrets to Git!

FRONTEND_PORT=3001
GATEWAY_PORT=8095
POSTGRES_PORT=5433
RABBITMQ_PORT=5673
RABBITMQ_MGMT_PORT=15673
REDIS_PORT=6380

# PostgreSQL superuser & per-service least-privilege credentials (DB-per-service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_ADMIN_PW
AUTH_DB_PASSWORD=CHANGE_ME_STRONG_AUTH_DB_PW
RATE_DB_PASSWORD=CHANGE_ME_STRONG_RATE_DB_PW
CONVERSION_DB_PASSWORD=CHANGE_ME_STRONG_CONVERSION_DB_PW
ALERT_DB_PASSWORD=CHANGE_ME_STRONG_ALERT_DB_PW
NOTIFICATION_DB_PASSWORD=CHANGE_ME_STRONG_NOTIFICATION_DB_PW

# RabbitMQ credentials
RABBITMQ_USERNAME=currency_app
RABBITMQ_PASSWORD=CHANGE_ME_STRONG_RABBITMQ_PW

# JWT signing secret (MUST be >= 32 bytes)
JWT_SECRET=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_BYTES_SECRET_KEY
JWT_ACCESS_TTL_SECONDS=3600
JWT_ISSUER=currency-platform-auth

# BNM Exchange Rates source
BNM_BASE_URL=https://www.bnm.md/en/official_exchange_rates
BNM_MAX_ROLLBACK_DAYS=7
